{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MixBridge",
  "version": "0.1.0",
  "identifier": "com.mixbridge.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MixBridge",
        "width": 980,
        "height": 620,
        "resizable": true,
        "minWidth": 760,
        "minHeight": 500,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
