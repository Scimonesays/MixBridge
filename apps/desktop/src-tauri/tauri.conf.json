{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MixBridge",
  "version": "0.1.0",
  "identifier": "com.mixbridge.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MixBridge",
        "width": 980,
        "height": 640,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/henry.w@example.net"
    ],
    "resources": [
      "../../../native/audio-engine/build/mb-engine-ipc.exe"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
